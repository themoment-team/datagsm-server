load("//bazel:defs.bzl", "datagsm_kotest_test", "datagsm_service", "datagsm_service_image")

# Module-specific deps from datagsm-oauth-authorization/build.gradle.kts:
# mail, OAuth2 client, JJWT.
datagsm_service(
    name = "oauth-authorization",
    main_class = "team.themoment.datagsm.oauth.authorization.DatagsmAuthorizationApplicationKt",
    extra_artifacts = [
        "org.springframework.boot:spring-boot-starter-mail",
        "org.springframework.boot:spring-boot-starter-oauth2-client",
        "io.jsonwebtoken:jjwt-api",
    ],
    extra_runtime_artifacts = [
        "io.jsonwebtoken:jjwt-impl",
        "io.jsonwebtoken:jjwt-jackson",
    ],
)

datagsm_service_image(
    name = "oauth-authorization",
    main_class = "team.themoment.datagsm.oauth.authorization.DatagsmAuthorizationApplicationKt",
)

datagsm_kotest_test(
    name = "oauth-authorization_test",
    associate = ":oauth-authorization_lib",
    spring_test = True,
)
