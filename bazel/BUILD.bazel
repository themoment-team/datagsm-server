load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_compiler_plugin")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Project-wide Kotlin toolchain. Mirrors buildSrc PluginVersions.KOTLIN_VERSION (2.3.10)
# and datagsm-ksp-processor's JVM 21 target. jsr305=strict matches the service-module
# freeCompilerArgs in the root build.gradle.kts.
define_kt_toolchain(
    name = "kotlin_toolchain",
    api_version = "2.3",
    jvm_target = "21",
    language_version = "2.3",
)

# Shared Kotlin compiler plugins replicating the Gradle kotlin-spring / kotlin-jpa plugins.
# Used by datagsm-common and every service module (root build's isServiceModule block).

# kotlin-spring: all-open for @Component/@Transactional/@Async/@Cacheable/@Validated.
kt_compiler_plugin(
    name = "allopen_spring",
    id = "org.jetbrains.kotlin.allopen",
    options = {"preset": "spring"},
    visibility = ["//visibility:public"],
    deps = ["@rules_kotlin//kotlin/compiler:allopen-compiler-plugin"],
)

# kotlin-jpa: no-arg constructor for @Entity/@Embeddable/@MappedSuperclass.
kt_compiler_plugin(
    name = "noarg_jpa",
    id = "org.jetbrains.kotlin.noarg",
    options = {"preset": "jpa"},
    visibility = ["//visibility:public"],
    deps = ["@rules_kotlin//kotlin/compiler:noarg-compiler-plugin"],
)

# kotlinx.serialization: generates serializers for @Serializable classes (datagsm-shared).
kt_compiler_plugin(
    name = "kotlinx_serialization",
    compile_phase = True,
    id = "org.jetbrains.kotlinx.serialization",
    stubs_phase = True,
    visibility = ["//visibility:public"],
    deps = ["@rules_kotlin//kotlin/compiler:kotlinx-serialization-compiler-plugin"],
)

# Target platform for the container image (Docker Desktop on Apple Silicon runs linux/arm64
# natively). Building the image under --platforms=//bazel:linux_arm64 makes the java_binary
# bundle a LINUX remotejdk instead of the host's macOS JDK.
platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

# --- ktlint (replaces the Gradle ktlint plugin) ---
# Runs the official self-contained ktlint-cli `-all` jar directly (see ktlint.sh).
sh_binary(
    name = "ktlint",
    srcs = ["ktlint.sh"],
    data = ["@maven//:com_pinterest_ktlint_ktlint_cli_all"],
    visibility = ["//visibility:public"],
)
