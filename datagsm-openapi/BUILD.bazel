load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel:defs.bzl", "datagsm_service")
load("//bazel:jars.bzl", "runtime_classpath")

# Simplest service module — no module-specific deps (per its build.gradle.kts).
# Proven in Phase 3 to compile and run as a real Spring Boot app from a flat classpath.
#
# Deployable artifact (research findings — both fat-jar paths fail):
#   1. rules_spring 2.6.3 (purpose-built bootJar equivalent) is INCOMPATIBLE with Bazel 9
#      — its springboot.bzl references the removed global `JavaInfo` symbol.
#   2. A native java_binary `_deploy.jar` (flat über-jar) builds but FAILS at runtime with
#      BeanDefinitionOverrideException: merging every class into one classpath root defeats
#      Spring Data's JPA-vs-Redis multi-store repository disambiguation (the same repo gets
#      registered for both stores). The layered classpath (kt_jvm_binary runfiles) avoids it.
# Recommended path: containerize the kt_jvm_binary with rules_oci (preserves the working
# layered classpath), rather than reproducing Gradle's fat bootJar.
datagsm_service(
    name = "openapi",
    main_class = "team.themoment.datagsm.openapi.DatagsmResourceApplicationKt",
)

# --- Container deployment (research): base-image JRE + the full transitive runtime
# classpath as arch-independent jars. Preserves the SEPARATE-jar layered classpath that
# boots correctly (the flat fat-jar broke Spring Data multi-store), with no JDK-bundling
# platform transition (jars are bytecode; the base image supplies the JRE). ---

runtime_classpath(
    name = "openapi_runtime_jars",
    deps = [":openapi_lib"],
)

pkg_tar(
    name = "openapi_layer",
    srcs = [":openapi_runtime_jars"],
    package_dir = "/app/lib",
)

oci_image(
    name = "openapi_image",
    base = "@temurin_jre",
    # Java expands `/app/lib/*` to every jar in the dir (classpath wildcard).
    entrypoint = [
        "java",
        "-cp",
        "/app/lib/*",
        "team.themoment.datagsm.openapi.DatagsmResourceApplicationKt",
    ],
    tars = [":openapi_layer"],
)

# `bazel run //datagsm-openapi:openapi_image_load` loads it into the local Docker daemon.
oci_load(
    name = "openapi_image_load",
    image = ":openapi_image",
    repo_tags = ["datagsm-openapi:bazel"],
)
